{
  "name": "dsh-sidebar-toggle",
  "version": "0.1.1",
  "description": "Quickly toggle the DeepSeek Harness Web UI sidebar grouping between workspace and flat list via Alt+R or by clicking the section header title (Sessions / Workspaces). dsh Web GUI 侧边栏分组快捷切换插件：支持按 Alt+R 快捷键或直接点击侧边栏分组标题（会话 / 工作区）在工作区分组与平铺会话列表间一键切换。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node --check lib/index.js && node --check lib/client.js",
    "prepare": "npm run build",
    "release": "npm version patch && npm pack --pack-destination /tmp"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "toggle",
    "workspace",
    "sessions",
    "group-by",
    "flat-list",
    "shortcut",
    "web-ui",
    "侧边栏",
    "工作区",
    "会话列表",
    "分组切换",
    "平铺视图",
    "快捷键"
  ],
  "author": "johnnren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-walks-slow/dsh-sidebar-toggle.git"
  },
  "homepage": "https://github.com/john-walks-slow/dsh-sidebar-toggle#readme",
  "bugs": {
    "url": "https://github.com/john-walks-slow/dsh-sidebar-toggle/issues"
  }
}
